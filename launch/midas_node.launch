<launch>

   <!-- Gazebo -->
  <!-- <param name="input_img_topic" value="/uav1/rgbd/color/image_raw" />
  <param name="input_camera_info_topic" value="/uav1/rgbd/color/camera_info" />
  <param name="camera_frame" value="uav1/rgbd/color_optical" /> -->

  <!-- Unreal simulator -->
  <param name="input_img_topic" value="/uav1/stereo/left/image_raw" />
  <param name="input_camera_info_topic" value="/uav1/stereo/left/camera_info" />
  <param name="camera_frame" value="uav1/stereo_left" />
        


  <!-- <param name="input_pointcloud_topic" value="/uav1/lidar/points" /> -->
  <param name="input_pointcloud_topic" value="/uav1/ov_msckf/points_slam" />


  <param name="output_openVins_image_topic" value="/midas/rgb_OpenVins_view" />
  <param name="output_depth_map_topic" value="/midas/depth_view" />

  <param name="output_scaled_depth_map_topic_map" value="/midas/scaled_depth_view_map" />
  <param name="output_scaled_depth_map_topic_value" value="/midas/scaled_depth_view_value" />
  <param name="output_pointcloud_topic_map" value="/midas/pointcloud_by_map" />
  <param name="output_pointcloud_topic_value" value="/midas/pointcloud_by_value" />
  


  <node pkg="monodepth_navigation" type="monocular_depth_estimator.py" name="monodepth_estimator" output="screen" />
</launch>
